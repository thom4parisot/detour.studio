{{- $Weeknotes := where site.RegularPages "Section" "weeknotes" -}}
{{- $Yearnotes := where site.RegularPages "Section" "yearnotes" -}}
{{- $pages := union $Weeknotes $Yearnotes -}}
{{- $limit := site.Config.Services.RSS.Limit | default 10 -}}
{{- $pages := sort $pages "Date" "desc" | first $limit -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq  .Title  .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} • {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{- .Description | default (.Summary | plainify | emojify | strings.TrimSpace) -}}</description>
    <generator>Hugo -- gohugo.io</generator>{{ with .Site.Language.Locale }}
    <language>{{.}}</language>{{end}}{{ with .Site.Params.author.email }}
    <managingEditor>{{.}}{{ with $.Site.Params.author.name }} ({{.}}){{end}}</managingEditor>{{end}}{{ with .Site.Params.author.email }}
    <webMaster>{{.}}{{ with $.Site.Params.author.name }} ({{.}}){{end}}</webMaster>{{end}}{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" -}}
	   {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{ end -}}
    {{ range $pages -}}
    <item>
<title>{{ .Title }}</title>
<link>{{ .Permalink }}</link>
<pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with .Site.Params.author.email }}<author>{{.}}{{ with $.Site.Params.author.name }} ({{.}}){{end}}</author>{{end}}
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{ `<description><![CDATA[` | safeHTML }} {{ .Content | emojify | safeHTML }} ]]></description>
      {{ with partial "page-image.html" . | partial "image-cover.html" -}}
        <enclosure url="{{ .Permalink }}" type="{{ .MediaType.Type }}" length="{{ len .Content }}" />
      {{- end }}
    </item>
    {{ end }}
  </channel>
</rss>
